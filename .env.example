# OpenClaw Snapshot — Backup & Restore Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Strong passphrase used to encrypt/decrypt backups
BACKUP_PASSWORD=

# GitHub Personal Access Token with 'repo' scope
# Create one at: https://github.com/settings/tokens
GITHUB_PAT=

# Your GitHub username
GITHUB_USERNAME=

# Name of the private GitHub repo for storing backups (default: openclaw-transport)
REPO_NAME=

# Folders to include in each snapshot, comma-separated, relative to your home
# directory (e.g. /home/coder). Leave unset to back up just .openclaw.
# Each entry can be a direct child of home or a nested path.
# Examples:
#   SNAPSHOT_FOLDERS=.openclaw
#   SNAPSHOT_FOLDERS=.openclaw, projects, notes
#   SNAPSHOT_FOLDERS=.openclaw, work/configs, .config/myapp
SNAPSHOT_FOLDERS=.openclaw
