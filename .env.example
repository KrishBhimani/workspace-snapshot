# Workspace Snapshot — Backup & Restore Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Strong passphrase used to encrypt/decrypt backups
BACKUP_PASSWORD=

# GitHub Personal Access Token with 'repo' scope
# Create one at: https://github.com/settings/tokens
# Optional if the GitHub CLI is installed and logged in (gh auth login):
# leave blank and the gh login's token is used instead.
GITHUB_PAT=

# Your GitHub username
# Optional: leave blank to look it up from the token in use.
GITHUB_USERNAME=

# Name of the private GitHub repo for storing backups (default: xo-workspace-backup)
REPO_NAME=

# Folders to include in each snapshot, comma-separated, relative to your home
# directory (e.g. /home/coder). Leave unset to back up just .claude.
# Each entry can be a direct child of home or a nested path.
# Examples:
#   SNAPSHOT_FOLDERS=.claude
#   SNAPSHOT_FOLDERS=.claude, projects, notes
#   SNAPSHOT_FOLDERS=.claude, work/configs, .config/myapp
SNAPSHOT_FOLDERS=.claude
